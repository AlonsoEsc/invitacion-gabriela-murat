{
  "name": "invitacion-gabriela-murat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix server run dev:memory",
    "dev:api:persistent": "npm --prefix server run dev",
    "dev:full": "concurrently -k -n API,WEB -c magenta,cyan \"npm run dev:api\" \"npm run dev -- --host 127.0.0.1 --port 5174\"",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:pages": "vite build",
    "package:ifastnet": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-ifastnet.ps1",
    "preview": "vite preview",
    "start": "npm --prefix server start",
    "test": "node --test tests/csv.test.mjs && npm --prefix server test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "server:test": "npm --prefix server test"
  },
  "dependencies": {
    "@fontsource/allura": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.2.8",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
